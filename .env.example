# --- Calculadoras da Receita (containers locais) — alternativa oficial online:
# RF_API_URL=https://piloto-cbs.tributos.gov.br/servico/calculadora-consumo/api
RF_API_URL=http://localhost:8080/api
RF_SN_API_URL=http://localhost:8082/api
# Produção: segredo exigido pelo Caddy na frente das calculadoras (vazio no local)
RF_INTERNAL_KEY=

# --- Chave mestra (32 bytes em base64) para cifrar certificado e CSC. Gere com:
#   openssl rand -base64 32
NOTALEVE_MASTER_KEY=

# --- SEFAZ: 'mock' usa infra/sefaz-mock; 'real' usa o webservice da UF (homologação)
SEFAZ_MODO=mock
SEFAZ_MOCK_URL=http://localhost:8090
# Modo real: PEM com as raízes/intermediárias ICP-Brasil (ITI) — as SEFAZ usam a AC Raiz Brasileira v10
SEFAZ_CA_FILE=infra/certs/icp-brasil.pem

# --- Responsável técnico (infRespTec) — CNPJ da empresa operadora do NotaLeve
RESP_TEC_CNPJ=00000000000000
RESP_TEC_CONTATO=NotaLeve
RESP_TEC_EMAIL=contato@notaleve.local
RESP_TEC_FONE=11999999999

# --- Asaas: sem ASAAS_API_KEY roda em modo simulado (sem chamadas externas)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=troque-este-token-local
APP_URL=http://localhost:3000
