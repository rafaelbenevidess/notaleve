{
  "name": "notaleve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sefaz:mock": "tsx infra/sefaz-mock/server.ts",
    "receita:up": "docker compose -f infra/receita/docker-compose.yml up -d",
    "test": "vitest run",
    "test:rls": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -q -f supabase/tests/rls_isolamento.sql",
    "test:e2e": "playwright test --trace off",
    "cert:teste": "tsx scripts/certificado-teste.ts",
    "local": "bash scripts/subir-local.sh",
    "test:tudo": "vitest run && npm run test:rls && playwright test --trace off",
    "db:tipos": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}